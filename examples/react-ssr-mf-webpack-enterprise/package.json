{
  "name": "container-web-app-example",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "templates/template1",
    "templates/template2"
  ],
  "scripts": {
    "start": "node scripts/run.js",
    "build": "npm run build:client && npm run build:ssr",
    "verify": "node verify-build.js",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "analyze:build": "NODE_ENV=production webpack --config webpack.config.js --mode production --profile --json > dist/stats.json && npm run analyze",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "lint:fix": "npm run format && eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "build:client": "webpack --config webpack.config.js",
    "build:ssr": "webpack --config webpack.ssr.js",
    "start:ssr": "node server/index.js",
    "check": "node --check webpack.config.js && node --check webpack.ssr.js && node --check scripts/run.js && node --check server/index.js && node --check core/Store/store.js && node --check core/Store/shellSlice.js && node --check core/Store/sharedActions.js && node --check core/Store/sharedSelectors.js"
  },
  "dependencies": {
    "@babel/core": "^7.27.4",
    "@reduxjs/toolkit": "^2.8.2",
    "@svgr/webpack": "^8.1.0",
    "compression-webpack-plugin": "^11.1.0",
    "css-loader": "^7.1.2",
    "dotenv": "^16.5.0",
    "eslint-webpack-plugin": "^5.0.2",
    "fastify": "^5.7.4",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.1",
    "sass": "^1.89.1",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "eslint": "^9.32.0",
    "eslint-formatter-pretty": "^6.0.1",
    "webpack-bundle-analyzer": "^4.10.1"
  }
}
